ENV=dev
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
DB_PATH=data/kanakku.db
UPLOAD_DIR=data/uploads
BACKUP_DIR=data/backups

OLLAMA_URL=http://localhost:11434
LLM_TEXT_MODEL=qwen2.5:7b
LLM_VISION_MODEL=qwen2.5vl:7b
EMBED_MODEL=nomic-embed-text
RERANK_MODEL=BAAI/bge-reranker-base
LLM_TIMEOUT_S=180

# Comma-separated emails that may open the AI usage (metrics) page
ADMIN_EMAILS=
# Max AI requests (bill reads, GST questions, reminder drafts) per user per hour
AI_RATE_LIMIT_PER_HOUR=60
